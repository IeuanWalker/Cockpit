<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="Microsoft.Build.Framework" HintPath="$(MSBuildBinPath)\Microsoft.Build.Framework.dll" Private="true" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(MSBuildBinPath)\Microsoft.Build.Utilities.Core.dll" Private="true" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cockpit.Tooling.Abstractions\Cockpit.Tooling.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Cockpit.Tooling.Discovery\Cockpit.Tooling.Discovery.csproj" />
    <ProjectReference Include="..\..\src\Cockpit.Tooling.Discovery.Build\Cockpit.Tooling.Discovery.Build.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <EmbeddedResource Include="workspace-tool-assemblies.json" LogicalName="workspace-tool-assemblies.json" />
  </ItemGroup>
</Project>
