<div class="h-full min-h-0 flex flex-col">
    @if(ShowSearch)
    {
        <div class="px-2 py-1.5 border-b border-app-border">
            <div class="flex items-center gap-1">
                <div class="flex-1 relative">
                    <input type="text"
                           @ref="_sessionSearch"
                           @bind="SearchText"
                           @bind:event="oninput"
                           placeholder="Search sessions..."
                           aria-label="Search sessions"
                           id="sessionSearch"
                           class="w-full px-2 py-1 rounded text-xs focus:outline-none"
                           style="background-color: var(--input-bg); border: 1px solid var(--input-border); color: var(--text-color);" />
                    @if(!string.IsNullOrEmpty(_searchText))
                    {
                        <button type="button"
                                @onclick="ClearAndFocusSearch"
                                aria-label="Clear session search"
                                class="absolute right-1.5 top-1/2 -translate-y-1/2 p-0.5 hover:bg-app-hover rounded">
                            <svg class="w-3 h-3 secondary-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    }
                </div>
                <button type="button"
                        @onclick="ToggleFilterPanel"
                        aria-expanded="@(_showFilterPanel ? "true" : "false")"
                        aria-controls="session-filter-panel"
                        class="p-1 rounded flex-shrink-0 @(_showFilterPanel || HasActiveFilters ? "hover:opacity-75" : "hover:bg-app-hover")"
                        style="@(_showFilterPanel || HasActiveFilters ? "background-color: var(--accent-color);" : string.Empty)"
                        title="Filter">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                    </svg>
                </button>
            </div>
            @if(_showFilterPanel)
            {
                <div id="session-filter-panel" class="mt-1.5 border border-app-border rounded p-2 text-xs space-y-1" style="background-color: var(--sidebar-color);">
                    @if(UniqueCwds.Any())
                    {
                        <div>
                            <div class="secondary-text font-medium mb-1 uppercase tracking-wide" style="font-size: 10px;">Working Directory</div>
                            @foreach(var group in GroupedCwds)
                            {
                                var items = group.ToList();
                                var allSelected = items.All(cwd => _filterCwds.Contains(cwd));
                                var anySelected = items.Any(cwd => _filterCwds.Contains(cwd));
                                var isMulti = items.Count > 1;
                                var isExpanded = _expandedCwdGroups.Contains(group.Key);
                                var groupActive = allSelected || anySelected;

                                <!-- Group header row -->
                                <div class="flex items-center gap-0.5">
                                    <button @onclick="() => ToggleCwdGroup(group)"
                                            role="checkbox"
                                            aria-checked="@(allSelected ? "true" : anySelected ? "mixed" : "false")"
                                            class="flex-1 flex items-center gap-1.5 py-0.5 px-1 hover:bg-app-hover rounded text-left min-w-0"
                                            title="@string.Join("\n", items)">
                                        <svg class="w-3 h-3 flex-shrink-0" viewBox="0 0 24 24">
                                            <rect x="3" y="3" width="18" height="18" rx="2"
                                                  fill="@(allSelected || anySelected ? "var(--accent-color)" : "none")"
                                                  stroke="@(allSelected || anySelected ? "var(--accent-color)" : "currentColor")"
                                                  stroke-width="2" />
                                            @if(allSelected)
                                            {
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" stroke="white" fill="none" d="M6 12l4 4 8-8" />
                                            }
                                            else if(anySelected)
                                            {
                                                <line x1="7" y1="12" x2="17" y2="12" stroke-width="2.5" stroke-linecap="round" stroke="white" />
                                            }
                                        </svg>
                                        <span class="truncate text-xs text-app-title">@group.Key</span>
                                        @if(isMulti)
                                        {
                                            <span class="text-xs secondary-text flex-shrink-0">(@items.Count)</span>
                                        }
                                    </button>
                                    @if(isMulti)
                                    {
                                        <button @onclick="() => ToggleCwdGroupExpand(group.Key)"
                                                class="p-0.5 hover:bg-app-hover rounded flex-shrink-0"
                                                title="@(isExpanded ? "Collapse" : "Expand")">
                                            <svg class="w-3 h-3 secondary-text transition-transform @(isExpanded ? "" : "-rotate-90")" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                                            </svg>
                                        </button>
                                    }
                                </div>

                                <!-- Individual items (only for multi-path groups when expanded) -->
                                @if(isMulti && isExpanded)
                                {
                                    @foreach(var cwd in items)
                                    {
                                        var cwdActive = _filterCwds.Contains(cwd);
                                        <button @onclick="() => ToggleCwdFilter(cwd)"
                                                role="checkbox"
                                                aria-checked="@(cwdActive ? "true" : "false")"
                                                class="w-full flex items-center gap-1.5 py-0.5 pl-5 pr-1 hover:bg-app-hover rounded text-left">
                                            <svg class="w-3 h-3 flex-shrink-0" viewBox="0 0 24 24">
                                                <rect x="3" y="3" width="18" height="18" rx="2"
                                                      fill="@(cwdActive ? "var(--accent-color)" : "none")"
                                                      stroke="@(cwdActive ? "var(--accent-color)" : "currentColor")"
                                                      stroke-width="2" />
                                                @if(cwdActive)
                                                {
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" stroke="white" fill="none" d="M6 12l4 4 8-8" />
                                                }
                                            </svg>
                                            <span class="truncate text-xs secondary-text" title="@cwd">@cwd</span>
                                        </button>
                                    }
                                }
                            }
                        </div>
                    }
                    @if(UniqueRepos.Any())
                    {
                        <div>
                            <div class="secondary-text font-medium mb-1 uppercase tracking-wide" style="font-size: 10px;">Repository</div>
                            @foreach(var repo in UniqueRepos)
                            {
                                var repoActive = _filterRepos.Contains(repo);
                                <button @onclick="() => ToggleRepoFilter(repo)"
                                        role="checkbox"
                                        aria-checked="@(repoActive ? "true" : "false")"
                                        class="w-full flex items-center gap-1.5 py-0.5 px-1 hover:bg-app-hover rounded text-left">
                                    <svg class="w-3 h-3 flex-shrink-0" viewBox="0 0 24 24">
                                        <rect x="3" y="3" width="18" height="18" rx="2"
                                              fill="@(repoActive ? "var(--accent-color)" : "none")"
                                              stroke="@(repoActive ? "var(--accent-color)" : "currentColor")"
                                              stroke-width="2" />
                                        @if(repoActive)
                                        {
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" stroke="white" fill="none" d="M6 12l4 4 8-8" />
                                        }
                                    </svg>
                                    <span class="truncate text-xs text-app-title" title="@repo">@repo</span>
                                </button>
                            }
                        </div>
                    }
                    @if(!UniqueCwds.Any() && !UniqueRepos.Any())
                    {
                        <span class="secondary-text">No filter options available</span>
                    }
                </div>
            }
        </div>
    }

    <div class="flex-1 min-h-0 overflow-y-auto scrollbar-thin relative"
         data-session-scroll-container
         tabindex="0"
         aria-label="Sessions">
        @if(IsSearchActive && Rows.Count == 0)
        {
            <div class="px-3 py-4 text-center">
                <span class="secondary-text text-xs">No sessions found</span>
            </div>
        }
        else
        {
            @foreach(SessionListRow row in Rows)
            {
                <div @key="row.Key" class="@(row is SessionListSectionHeaderRow ? string.Empty : "session-list-row-reveal")">
                    @switch(row)
                    {
                        case SessionListSectionHeaderRow section:
                            <button type="button"
                                    @onclick="() => ToggleSectionExpand(section.Section)"
                                    class="session-section-header"
                                    aria-expanded="@(section.IsExpanded ? "true" : "false")">
                                <span>@section.Name</span>
                                <svg class="session-section-chevron @(section.IsExpanded ? "expanded" : string.Empty)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" />
                                </svg>
                            </button>
                            break;
                        case SessionListSessionRow sessionRow:
                            <div data-session-scope="@sessionRow.ScopeId"
                                 style="padding-left: @(sessionRow.IndentLevel * 12)px;">
                                <SessionListItem Session="@sessionRow.Session"
                                                 IsActive="@(_sessionFeature.CurrentSession?.Id == sessionRow.Session.Id)"
                                                 IsPinned="@_pinnedItemsFeature.IsSessionPinned(sessionRow.Session.Id)"
                                                 OnSelect="SelectSession"
                                                 OnTogglePin="() => ToggleSessionPin(sessionRow.Session.Id)"
                                                 OnDelete="@(e => ShowDeleteDialog(sessionRow.Session, e))"
                                                 TimeAgo="@GetTimeAgo(sessionRow.Session.LastActivity)" />
                            </div>
                            break;
                        case SessionListRecentsRow recents:
                            <Virtualize Items="@recents.Sessions" Context="recentSession" ItemSize="32" OverscanCount="5">
                                <div @key="recentSession.Id"
                                     class="session-recents-virtualized-row"
                                     data-session-scope="recents"
                                     style="padding-left: 12px;">
                                    <SessionListItem Session="@recentSession"
                                                     Compact="true"
                                                     IsActive="@(_sessionFeature.CurrentSession?.Id == recentSession.Id)"
                                                     IsPinned="@_pinnedItemsFeature.IsSessionPinned(recentSession.Id)"
                                                     OnSelect="SelectSession"
                                                     OnTogglePin="() => ToggleSessionPin(recentSession.Id)"
                                                     OnDelete="@(e => ShowDeleteDialog(recentSession, e))"
                                                     TimeAgo="@GetTimeAgo(recentSession.LastActivity)" />
                                </div>
                            </Virtualize>
                            break;
                        case SessionListProjectHeaderRow group:
                            <SessionListProjectItem GroupId="@group.GroupId"
                                                    Name="@group.Name"
                                                    IsExpanded="@group.IsExpanded"
                                                    IsPinned="@_pinnedItemsFeature.IsProjectPinned(group.GroupId)"
                                                    CreateSessionPath="@group.CreateSessionPath"
                                                    Repository="@group.Repository"
                                                    SessionCount="@group.SessionCount"
                                                    OnToggle="() => ToggleProjectGroupExpand(group.GroupId)"
                                                    OnTogglePin="() => ToggleProjectPin(group.GroupId)"
                                                    OnCreate="() => CreateSessionFromGroup(group)" />
                            break;
                        case SessionListShowMoreRow showMore:
                            <div class="session-show-more"
                                 data-session-group="@showMore.GroupId"
                                 style="padding-left: @(showMore.IndentLevel * 12 + 12)px;">
                                @if(showMore.HasMore)
                                {
                                    <button type="button" @onclick="() => ShowMoreSessions(showMore.GroupId)">Show more</button>
                                }
                                @if(showMore.CanShowLess)
                                {
                                    <button type="button" @onclick="() => ShowLessSessions(showMore.GroupId)">Show less</button>
                                }
                            </div>
                            break;
                    }
                </div>
            }
        }
    </div>
</div>
