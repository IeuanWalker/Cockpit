<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <IsPackable>true</IsPackable>
    <PackageId>Cockpit.Tooling.Discovery.Build</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Build.Framework" HintPath="$(MSBuildBinPath)\Microsoft.Build.Framework.dll" Private="false" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(MSBuildBinPath)\Microsoft.Build.Utilities.Core.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\Cockpit.Tooling.Discovery.Build.targets"
          Pack="true"
          PackagePath="buildTransitive\Cockpit.Tooling.Discovery.Build.targets" />
  </ItemGroup>

  <Target Name="IncludeTaskAssemblyInPackage" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="tools\net10.0" />
    </ItemGroup>
  </Target>
</Project>
